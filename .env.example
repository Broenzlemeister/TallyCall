# Domain, die auf den Server zeigt (DNS A-Record für @ und www)
DOMAIN=tallycall.com
# Öffentliche Adresse für Freigabe-Links (mit https://)
PUBLIC_URL=https://tallycall.com
# Registrierung offen (1) oder geschlossen (0). Nach dem Anlegen der Konten auf 0 setzen, dann nur per Einladung.
ALLOW_SIGNUP=1
# Zeitzone, die neue Projekte vorschlagen
TZ_SHOW=Europe/Berlin
# Optional: fester Schlüssel für Sitzungen (sonst wird einer in /data erzeugt)
SESSION_SECRET=

# Eigenes (Wildcard-)Zertifikat statt Let's Encrypt: Dateien certs/fullchain.pem + certs/privkey.pem ablegen und aktivieren:
# CADDYFILE=Caddyfile.cert

# --- Trigger und Steuerung ---
# Trigger-Politik: public = nur öffentliche Adressen (Standard online), all = auch LAN (lokaler Server), off = aus
TALLYCALL_TRIGGERS=public
# OSC-Eingang (UDP-Port), leer = aus. Nur für lokale Server sinnvoll.
OSC_PORT=

# --- Lizenzen und Bezahlung ---
# Server-Admins (Komma-getrennt). Das erste registrierte Konto ist automatisch Admin.
ADMIN_EMAIL=
# Lizenzen durchsetzen (Free/Pro): on oder off
TALLYCALL_PLANS=on
# Stripe Payment Link für den Pro-Plan (leer = kein Kauf möglich, Freischaltung nur manuell unter /admin)
PAY_LINK=
# Laufzeit in Monaten je Kauf
PLAN_MONTHS=12
# Signatur-Geheimnis des Stripe-Webhooks (https://DOMAIN/api/stripe/webhook, Ereignis checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
